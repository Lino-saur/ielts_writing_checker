{
  "name": "ielts-writing-checker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib scripts tests --ext .ts,.tsx,.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "evaluate:ielts-loop": "node --env-file=.env.local --import tsx scripts/evaluate-ielts-regression.ts --live",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:production": "node --env-file-if-exists=.env.local --import tsx scripts/check-production-readiness.ts",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:import:historical": "tsx scripts/import-historical-practice-data.ts",
    "db:import:courseware-rules": "tsx scripts/import-courseware-teaching-rules.ts",
    "db:seed:practice": "node scripts/seed-practice-library.mjs",
    "db:sync:historical:koolearn": "node scripts/sync-koolearn-historical-practice.mjs",
    "db:sync:practice:koolearn": "node scripts/sync-koolearn-practice-library.mjs"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.9",
    "better-auth": "1.6.13",
    "docx": "^9.7.1",
    "next": "15.5.21",
    "pg": "^8.21.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-is": "^19.2.8",
    "recharts": "^3.8.1",
    "svix": "1.99.0"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/pg": "^8.20.0",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.21",
    "tsx": "^4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  },
  "overrides": {
    "postcss": "8.5.16",
    "sharp": "0.35.0"
  }
}
